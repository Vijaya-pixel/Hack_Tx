# Sample settings. Copy this file to .env and fill in what you have. Never commit .env.

# TigerData (the database)
DATABASE_URL=postgres://tsdbadmin:PASTE_PASSWORD_HERE@YOUR_HOST:YOUR_PORT/tsdb?sslmode=require
PGSSL_CA_PATH=/path/to/timescale-ca.pem

# Keys that protect saved data. Make them with: openssl rand -base64 32   and   openssl rand -hex 32
DATA_ENCRYPTION_KEY=
HASH_SECRET=

# Google Gemini (answers on the Ask page). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

PORT=4000

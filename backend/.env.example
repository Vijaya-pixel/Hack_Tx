# Copy to .env and fill in. Never commit .env. Everything is optional: with no keys the app runs on fallback data.

# TigerData (TimescaleDB) for transactions and the continuous aggregate
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# TigerData uses Timescale's own certificate authority. To verify the server, save its CA certificate to a file and set:
# PGSSL_CA_PATH=/path/to/timescale-ca.pem
# PGSSL=insecure skips the check entirely (still encrypted, but the server is not authenticated). Quick tests only.

# Keys for the data we store about visitors (loan inputs, questions, requests).
#   DATA_ENCRYPTION_KEY encrypts the sensitive values (AES-256-GCM). Make one with:  openssl rand -base64 32
#   HASH_SECRET         is used to hash the anonymous session id (HMAC-SHA256). Make one with:  openssl rand -hex 32
# Keep both secret. If you lose DATA_ENCRYPTION_KEY, saved values can no longer be read.
DATA_ENCRYPTION_KEY=
HASH_SECRET=

# Google Gemini answers the Ask page when a key is set. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash   (best on the free tier; Pro models need a paid plan)


# API port
PORT=4000

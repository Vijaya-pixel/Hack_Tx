# Copy to .env and fill in. Never commit .env. Everything is optional: with no keys the app runs on fallback data.

# TigerData (TimescaleDB) for transactions and the continuous aggregate
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# PGSSL=insecure

# Google Gemini answers the Ask page when a key is set. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro


# API port
PORT=4000

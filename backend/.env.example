# Copy to .env and fill in. Never commit .env. Everything is optional: with no keys the app runs on fallback data.

# TigerData (TimescaleDB) for transactions and the continuous aggregate
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# PGSSL=insecure

# Snowflake (customer, loan, hardship requests, Cortex)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Key-pair auth instead of a password:
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=ROUNDUP
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
# Cortex model; if your region lacks it, set CORTEX_ENABLED_CROSS_REGION='ANY_REGION' on the account
SNOWFLAKE_CORTEX_MODEL=mistral-large2

# Google Gemini answers the Ask page when a key is set (it takes priority over Cortex). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# API port
PORT=4000
